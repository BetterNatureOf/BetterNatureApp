rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // Multi-role: a user can hold extra roles beyond their primary
    // `role`. Defaults to [] when the field is missing.
    function rolesArray() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('roles', []);
    }
    // True if the writer holds ANY of `targets` either as their
    // primary `role` or anywhere in their supplemental `roles[]`.
    function hasAnyRole(targets) {
      return isSignedIn()
        && (role() in targets || rolesArray().hasAny(targets));
    }
    // Role hierarchy used across web + app:
    //   super_admin > admin > volunteer / partner / member
    // Actual roles used across the app:
    //   member  - default volunteer
    //   chapter_president (or chapter_pres) - runs one chapter
    //   executive - org-wide c-suite (highest)
    //   restaurant - food donor portal
    // Legacy 'admin' / 'super_admin' kept for backwards compat with
    // any seed accounts that predate the role rename.
    function isExec()       { return hasAnyRole(['executive', 'admin', 'super_admin']); }
    function isAdmin()      { return hasAnyRole(['executive', 'admin', 'super_admin']); }
    function isPresident()  { return hasAnyRole(['chapter_president', 'chapter_pres', 'executive', 'admin', 'super_admin']); }
    function isSuperAdmin() { return hasAnyRole(['executive', 'super_admin']); }

    // The signed-in user's chapter_id (from their user doc). Used to
    // enforce that a chapter president can only edit objects in their
    // own chapter — not another chapter's events/announcements/etc.
    function myChapterId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.chapter_id;
    }
    // True when the writer is a president AND the chapterId in
    // question matches their own chapter. Execs bypass — they can
    // act across all chapters.
    function isPresOfChapter(chapterId) {
      return isExec()
        || (isSignedIn()
            && hasAnyRole(['chapter_president', 'chapter_pres'])
            && chapterId != null
            && chapterId == myChapterId());
    }

    // ── users ──
    // Reads: any signed-in user. (Audit A2 — split to public_profiles
    // deferred to a follow-up PR; too many call sites to break at once.)
    //
    // Writes: owner can touch non-privileged fields; privileged ones
    // require an exec OR the founder editing their own doc. On CREATE,
    // we additionally restrict what the owner can seed so an attacker
    // cannot self-mint `role: executive` via the SDK (audit A1).
    function isFounderToken() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
             'satvik.koya@betternatureofficial.org',
           ];
    }
    // Hard-privileged fields: authorization vectors that only exec
    // can self-write (plus the founder's own doc).
    function touchesPrivilegedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role','roles','member_status','verification_status','restaurant_status','disabled','disabled_at']);
    }
    // Roles a user is allowed to self-assign at signup. Everything
    // higher (chapter_president, executive, admin, super_admin) must
    // come from an exec update, not a client write.
    function isSelfAssignableRole(r) {
      return r == null || r in ['member', 'restaurant'];
    }
    // Create-time field discipline (audit A1). Blocks a signed-up
    // member from seeding themselves as executive, pre-approved,
    // pre-verified, or role-elevated via the signup write.
    function cleanCreateFields() {
      let d = request.resource.data;
      // Member role must start pending (requires exec approval). Only
      // 'restaurant' may start with member_status 'approved' because
      // their gate is restaurant_status, not member_status. Blocks
      // audit B4 — self-create with member_status:'approved' bypass.
      let roleAtCreate = d.get('role', 'member');
      return isSelfAssignableRole(roleAtCreate)
          && (!('roles' in d) || d.roles.hasOnly(['member', 'restaurant', 'partner']))
          && (!('member_status' in d)
              || (roleAtCreate == 'member' && d.member_status == 'pending')
              || (roleAtCreate == 'restaurant' && d.member_status in ['pending', 'approved']))
          && (!('verification_status' in d) || d.verification_status in ['pending', 'none', 'unverified'])
          && (!('restaurant_status' in d) || d.restaurant_status in ['pending', 'incomplete'])
          && !('disabled' in d)
          && !('disabled_at' in d);
    }
    // Audit A4 — a chapter president can today self-write chapter_id
    // and acquire admin scope over another chapter's events. Block
    // chapter_id self-writes from users who currently hold a chapter-
    // scoped admin role. Ordinary members may still self-set their
    // own chapter (signup, Complete Profile) because that write
    // doesn't elevate any scope — their role has no chapter-admin
    // powers. Execs bypass via the outer isExec() clause.
    function selfChapterIdOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['chapter_id'])
          || !hasAnyRole(['chapter_president','chapter_pres']);
    }
    // Audit A3 — a member can today self-write restaurant_id to any
    // legit restaurant's id and then post pickups as that partner.
    // Limit self-writes to the one-shot signup transition: previous
    // restaurant_id must be null. After the signup finalization write
    // only exec can touch it.
    function selfRestaurantIdOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['restaurant_id'])
          || resource.data.get('restaurant_id', null) == null;
    }
    // One-shot restaurant signup finalization carve-out. A freshly
    // created user transitions themselves into a PENDING restaurant
    // partner by stamping restaurant_id + chapter linkage + roles.
    // Exec approval in Manage Restaurants is still required before
    // the partner is active, so this self-write doesn't elevate any
    // real power — it just gets them into the approval queue.
    function isSelfRestaurantSignup() {
      let d = request.resource.data;
      let o = resource.data;
      return o.get('restaurant_status', null) in [null, 'incomplete']
          && d.get('restaurant_status', null) in ['pending', 'incomplete']
          && d.get('role', o.get('role', 'member')) in ['member', 'restaurant']
          && (!('roles' in d) || d.roles.hasOnly(['member', 'restaurant', 'partner']))
          && !d.diff(o).affectedKeys()
             .hasAny(['member_status','verification_status','disabled','disabled_at']);
    }
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid) && cleanCreateFields();
      allow update: if isExec()
        || (isSelf(uid) && isFounderToken())
        || (isSelf(uid) && !touchesPrivilegedFields() && selfChapterIdOk() && selfRestaurantIdOk())
        || (isSelf(uid) && isSelfRestaurantSignup() && selfChapterIdOk() && selfRestaurantIdOk());
      allow delete: if isAdmin();
    }

    // ── chapters ──
    // Execs can create/delete any chapter and edit any chapter. A
    // chapter president can ONLY edit their own chapter doc (the one
    // whose id matches their user.chapter_id) — never a sibling
    // chapter's name, location, or status.
    match /chapters/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isExec()
        || (isSignedIn()
            && hasAnyRole(['chapter_president', 'chapter_pres'])
            && id == myChapterId());
    }

    // ── chapter_applications ──
    // Submitted from the signup-flow "Start a chapter" screen, which
    // means the writer is often NOT yet authenticated. Allow open
    // create with the required shape; exec reviews and approves to
    // materialize the real /chapters/{id} doc.
    match /chapter_applications/{id} {
      allow read: if isExec();
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.proposed_name is string
                    && request.resource.data.city is string;
      allow update, delete: if isExec();
    }

    // ── chapter_join_requests ──
    // Existing users asking to switch into / join a chapter. Set on
    // the user's request; exec approves which then flips
    // users/{uid}.chapter_id and marks the request approved.
    match /chapter_join_requests/{id} {
      allow read: if isExec()
                  || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isExec();
    }

    // ── events ──
    // Exec creates/edits/deletes anything; chapter pres creates and
    // edits ONLY events stamped with their own chapter_id, and
    // cannot reassign an event from their chapter to another by
    // changing chapter_id on update.
    match /events/{id} {
      allow read: if true;
      allow create: if isPresOfChapter(request.resource.data.chapter_id);
      allow update: if isPresOfChapter(resource.data.chapter_id)
                    && isPresOfChapter(request.resource.data.chapter_id);
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && hasAnyRole(['chapter_president', 'chapter_pres'])
                        && resource.data.chapter_id == myChapterId());
    }

    // ── event_signups ──
    match /event_signups/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isExec() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow delete: if isExec() || (isSignedIn() && resource.data.user_id == request.auth.uid);
    }

    // ── pickups ──
    // Restaurants create their own pickups when they post surplus;
    // volunteers progress them through the claim/enroute/complete
    // states; execs can do anything for org-wide queue management.
    //
    // Updates are now FIELD-LEVEL (audit A3): each legitimate
    // transition has its own allow-function enforcing the exact set
    // of fields it may touch, the status it must come from, the
    // status it must land in, and the identity doing the write.
    // This closes:
    //   • a current claimant arbitrarily rewriting status/weight/
    //     verified_by_restaurant_at (which minted fraudulent receipts
    //     and hours),
    //   • "claim-via-update" theft of an in-progress run by any
    //     signed-in user,
    //   • restaurant_id self-write mis-attributing pickups.
    function pickupRid() { return request.resource.data.restaurant_id; }
    function existingRid() { return resource.data.restaurant_id; }
    function userRid() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurant_id;
    }
    function isRestaurantOwner() {
      return isSignedIn() && existingRid() != null
        && (existingRid() == request.auth.uid || existingRid() == userRid());
    }
    function pChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function newStatus() { return request.resource.data.status; }
    function oldStatus() { return resource.data.status; }
    function isClaimant() {
      return isSignedIn() && resource.data.claimed_by == request.auth.uid;
    }

    // Volunteer atomically claims an available pickup. Blocks claim-
    // via-update theft (audit A3/C2) by requiring the previous status
    // to be 'available' and the previous claimed_by to be null.
    function isAtomicClaim() {
      return isSignedIn()
        && oldStatus() == 'available'
        && newStatus() == 'claimed'
        && resource.data.get('claimed_by', null) == null
        && request.resource.data.claimed_by == request.auth.uid
        && pChanged().hasOnly([
             'status','claimed_by','claimed_at','claimant_phone','claimant_name'
           ]);
    }

    // Current claimant releases their own claim before enroute. Clears
    // ownership + stamps cancel audit fields. Cannot be used after
    // enroute (handoff/abandonment is the right path there).
    function isSelfReleaseClaim() {
      return isClaimant()
        && oldStatus() == 'claimed'
        && newStatus() == 'available'
        && request.resource.data.get('claimed_by', null) == null
        && pChanged().hasOnly([
             'status','claimed_by','claimed_at','cancel_reason','cancelled_at'
           ]);
    }

    // Current claimant sets themselves enroute (travelling to pickup).
    // Narrow fields so the volunteer cannot smuggle a status→completed
    // or a weight write through this path.
    function isSelfSetEnroute() {
      return isClaimant()
        && oldStatus() == 'claimed'
        && newStatus() == 'enroute'
        && pChanged().hasOnly([
             'status','enroute_at',
             'fridge_id','fridge_name','fridge_address','fridge_lat','fridge_lng'
           ]);
    }

    // Current claimant swaps the destination fridge mid-run.
    function isSelfUpdateFridge() {
      return isClaimant()
        && pChanged().hasOnly([
             'fridge_id','fridge_name','fridge_address','fridge_lat','fridge_lng','fridge_changed_at'
           ]);
    }

    // Current claimant reports food spoiled/unusable. Lands in
    // 'completed' with spoiled=true + actual_weight_lbs=0 (so dashboard
    // reducers that fall back to estimated weight will no longer count
    // this as rescued — audit C7 is a separate reducer fix on top).
    function isSelfReportSpoiled() {
      return isClaimant()
        && oldStatus() in ['claimed','enroute']
        && newStatus() == 'completed'
        && request.resource.data.get('spoiled', false) == true
        && request.resource.data.get('actual_weight_lbs', 1) == 0
        && pChanged().hasOnly([
             'status','spoiled','spoiled_kind','spoiled_note',
             'completed_at','actual_weight_lbs','hours_earned'
           ]);
    }

    // Current claimant hands the run off to another volunteer. Clears
    // the current claim; next volunteer re-claims via isAtomicClaim.
    // Preserves handoff audit trail fields.
    function isSelfHandoffEnroute() {
      return isClaimant()
        && oldStatus() == 'enroute'
        && newStatus() == 'available'
        && request.resource.data.get('claimed_by', null) == null
        && pChanged().hasOnly([
             'status','claimed_by','claimed_at','claimant_name','claimant_phone',
             'handoff_from_uid','handoff_from_name','handoff_from_phone',
             'handoff_reason','handoff_at'
           ]);
    }

    // Current claimant completes delivery. REQUIRES a positive
    // actual_weight_lbs so a direct SDK write cannot land status=
    // completed with weight=0 (which would mint hours + an empty
    // receipt). The weight check is enforced server-side by the
    // transaction in completePickup; this rule is the belt-and-
    // suspenders enforcement at the auth layer.
    function isSelfComplete() {
      return isClaimant()
        && oldStatus() == 'enroute'
        && newStatus() == 'completed'
        && request.resource.data.actual_weight_lbs is number
        && request.resource.data.actual_weight_lbs > 0
        && pChanged().hasOnly([
             'status','completed_at','actual_weight_lbs','hours_earned',
             'dropoff_photo_url',
             'fridge_id','fridge_name','fridge_address','fridge_lat','fridge_lng','fridge_changed_at',
             'handoff_unverified','handoff_unverified_note','handoff_unverified_at'
           ]);
    }

    // Claimant stamps the receipt link onto their completed pickup.
    // Separate rule because the status does not change here but the
    // write happens outside the completion transaction.
    function isSelfStampReceipt() {
      return isClaimant()
        && oldStatus() == 'completed'
        && newStatus() == 'completed'
        && pChanged().hasOnly(['tax_receipt_id','tax_receipt_url','delivered_visible_to_restaurant']);
    }

    // Restaurant physically confirms the handoff. Audit C3: today the
    // CLAIMANT could stamp verified_by_restaurant_at themselves — this
    // isolates the write to the restaurant owner.
    function isRestaurantVerify() {
      return isRestaurantOwner()
        && pChanged().hasOnly([
             'verified_by_restaurant_at','verified_by_restaurant_uid','verified_by_restaurant_name'
           ]);
    }

    // Restaurant cancels before any claim OR before enroute. The
    // service layer already blocks cancel after enroute; this rule
    // enforces the field set.
    function isRestaurantCancel() {
      return isRestaurantOwner()
        && newStatus() == 'cancelled'
        && pChanged().hasOnly(['status','cancel_reason','cancelled_at']);
    }

    match /pickups/{id} {
      allow read: if isSignedIn();

      // Create: exec OR any signed-in user whose auth uid (or
      // mirrored restaurant_id) matches the pickup's restaurant_id.
      // We deliberately don't require role=='restaurant' on the rule
      // — the role string can drift during signup (member ->
      // restaurant migration etc.). The id-match is the real check.
      allow create: if isExec() || (
        isSignedIn() && pickupRid() != null
        && (pickupRid() == request.auth.uid || pickupRid() == userRid())
      );

      // Update: exec OR any of the narrow transition rules above.
      // Everything that doesn't match a transition is denied, which
      // means a direct SDK write with arbitrary fields can no longer
      // forge a completion or steal a claim.
      allow update: if isExec()
        || isAtomicClaim()
        || isSelfReleaseClaim()
        || isSelfSetEnroute()
        || isSelfUpdateFridge()
        || isSelfReportSpoiled()
        || isSelfHandoffEnroute()
        || isSelfComplete()
        || isSelfStampReceipt()
        || isRestaurantVerify()
        || isRestaurantCancel();

      allow delete: if isAdmin();
    }

    // ── restaurants ──
    // A new restaurant signup creates their own doc (with
    // status:'pending' and user_id matching their auth uid) so the
    // approval queue picks it up. Execs manage everything else.
    match /restaurants/{id} {
      allow read: if true;
      // Two legit paths:
      //  A) Public restaurant signup form — the signed-up user
      //     writes their own record with user_id == auth.uid and
      //     status == 'pending' so the queue picks it up.
      //  B) Exec onboarding — an exec creates the record on behalf
      //     of a partner (church community garden, offline signup,
      //     backfill of promoted members, etc.) with any status.
      // Without (B), backfillRestaurantDocs + updateUserRole
      // silently failed rules and the partner never appeared on
      // Manage Restaurants.
      allow create: if isExec()
        || (isSignedIn()
            && request.resource.data.user_id == request.auth.uid
            && request.resource.data.status == 'pending');
      allow update, delete: if isExec();
    }

    // ── donations ──
    // Users can see their own; exec sees all.
    match /donations/{id} {
      allow read: if isExec() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── notifications ──
    // Reads/updates are scoped to the recipient. Creates allowed for any
    // signed-in user: the pickup workflow generates them as side effects
    // of legitimate actions (createPickup notifies chapter members,
    // setPickupEnroute notifies the restaurant, completePickup notifies
    // both). Notifications carry no privileges — only a recipient + a
    // human-readable body — so the worst-case abuse is one user spamming
    // another, which we accept for now and can rate-limit later if needed.
    match /notifications/{id} {
      allow read, update: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn();
      allow delete: if isSelf(resource.data.user_id) || isAdmin();
    }

    // ── notifications_outbox ──
    // Audit A6: anonymous create was too permissive. Lock to signed-
    // in writers. Unauth signup-flow surfaces (chapter_applications,
    // partner forms) that previously dropped a receipt from here now
    // need a Cloud Function (planned in Phase 2). The dispatcher
    // reads/updates/deletes via admin SDK, which bypasses rules.
    match /notifications_outbox/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isExec();
    }

    // ── member_activity ──
    match /member_activity/{id} {
      allow read: if isSignedIn();
      allow write: if isExec();
    }

    // ── announcements ──
    // Exec broadcasts org-wide; chapter pres can broadcast ONLY to
    // their own chapter (must stamp chapter_id matching their user
    // doc on create, and can only edit/delete their own chapter's
    // announcements).
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create: if isPresOfChapter(request.resource.data.chapter_id);
      allow update: if isPresOfChapter(resource.data.chapter_id)
                    && isPresOfChapter(request.resource.data.chapter_id);
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && hasAnyRole(['chapter_president', 'chapter_pres'])
                        && resource.data.chapter_id == myChapterId());
    }

    // ── org_metrics ──
    match /org_metrics/{id} {
      allow read: if true;
      allow write: if isExec();
    }

    // ── org_stats (live counters that drive website ticker + app impact) ──
    // Public read so the marketing site can show real-time numbers without
    // an auth round-trip. Writes only happen from inside the app via
    // bumpOrgStats() — restricted to signed-in users so anonymous traffic
    // can't inflate the counters.
    //
    // Audit A7: beyond field-set whitelist, each counter must be a
    // non-negative forward increment bounded by a sane per-op maximum
    // so a logged-in attacker cannot console-write meals: -9999 or
    // meals: 99999999 to tank or inflate the ticker.
    function isForwardBump(key, maxDelta) {
      let old = resource.data.get(key, 0);
      let new_ = request.resource.data.get(key, old);
      return new_ is number
        && new_ >= old
        && (new_ - old) <= maxDelta;
    }
    match /org_stats/{id} {
      allow read: if true;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['meals','lbs','individuals','co2','water','events','hours','volunteers','chapters','updated_at'])
        && isForwardBump('meals',       50000)
        && isForwardBump('lbs',         50000)
        && isForwardBump('individuals', 50000)
        && isForwardBump('co2',       1000000)
        && isForwardBump('water',    10000000)
        && isForwardBump('events',       1000)
        && isForwardBump('hours',       10000)
        && isForwardBump('volunteers',   1000)
        && isForwardBump('chapters',       10);
      allow create, delete: if isExec();
    }

    // ── animals_helped, badges, user_badges, member_of_month, checklist_progress ──
    match /animals_helped/{id}    { allow read: if true; allow write: if isExec(); }
    match /badges/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /user_badges/{id}       { allow read: if isSignedIn(); allow write: if isExec(); }
    match /member_of_month/{id}   { allow read: if true; allow write: if isExec(); }
    match /checklist_progress/{id}{ allow read: if isSignedIn(); allow write: if isExec(); }

    // ── tax_receipts ──
    // Audit A5: `allow read: if true` permitted anonymous LIST of the
    // whole collection, exposing donor + volunteer PII and receipt
    // URLs. Split into `get` (open — doc id is unguessable, so the
    // URL itself is the capability) and `list` (exec-only).
    match /tax_receipts/{id} {
      allow get: if true;
      allow list: if isExec();
      // Receipts must be tied to a real /pickups/{id} that the
      // CURRENT signed-in user actually delivered (claimed_by ==
      // auth.uid) and that's in 'completed' status. Without this
      // anyone signed in could mint a forged receipt for any
      // restaurant via the JS SDK. Execs can mint anything (manual
      // backfills, paper receipts). Nobody edits or deletes — the
      // collection is immutable audit history.
      allow create: if isExec()
        || (isSignedIn()
            && request.resource.data.pickup_id is string
            && exists(/databases/$(database)/documents/pickups/$(request.resource.data.pickup_id))
            && get(/databases/$(database)/documents/pickups/$(request.resource.data.pickup_id)).data.claimed_by == request.auth.uid
            && get(/databases/$(database)/documents/pickups/$(request.resource.data.pickup_id)).data.status == 'completed');
      allow update, delete: if false;
    }

    // ── sms_outbox ──
    // Queue read/written by the Cloud Function dispatcher. Signed-in
    // users can enqueue (they're already authenticated to post a pickup,
    // claim, or complete — that's when we add to this queue). Nobody
    // reads or edits except the server function via admin SDK.
    match /sms_outbox/{id} {
      allow read: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── fridges (community fridge network) ──
    // Public read so the marketing site can render fridge pins on the map
    // without auth. Only admins manage the network (add/edit/deactivate
    // fridges); volunteers and restaurants merely read.
    match /fridges/{id} {
      allow read: if true;
      // Exec writes anywhere. A chapter pres can add/edit fridges
      // ONLY for their own chapter (chapter_id on create/update must
      // match the writer's user.chapter_id, and the existing chapter
      // on edits must match too — no moving a fridge into another
      // chapter from the pres view).
      allow create: if isExec()
                    || isPresOfChapter(request.resource.data.chapter_id);
      allow update: if isExec()
                    || (isPresOfChapter(resource.data.chapter_id)
                        && isPresOfChapter(request.resource.data.chapter_id));
      allow delete: if isAdmin();
    }

    // ── admin_invites (website /admin.html) ──
    // A one-time code lets someone sign up as an admin at /admin.html.
    // Reads are locked to (a) super-admins managing invites and (b) the
    // authenticated user whose own email matches the invite doc id —
    // otherwise the plaintext `code` field is exposed to anyone who
    // knows or guesses an invited email, which defeats the whole point
    // of the one-time code. Doc ids are always lowercased before write,
    // so we lowercase the token email for comparison too.
    match /admin_invites/{email} {
      allow read: if isSuperAdmin()
                  || (request.auth != null
                      && request.auth.token.email != null
                      && request.auth.token.email.lower() == email);
      allow write: if isSuperAdmin();
    }

    // ── admin_audit (edit history) ──
    // Admins can read; any signed-in admin can append; nobody edits past entries.
    match /admin_audit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── site_content (admin panel saves) ──
    // Anyone can read (public site reads its own content); admins write.
    match /site_content/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── org_units (Phase 1 slice 2 — dual-write shadow index) ──
    // Chapters + partners write shadow OrgUnit rows here so scope-
    // aware permissions have a single referent. Reads open (public
    // chapter directory reads through this eventually). Writes gated
    // to the same principals that can already touch the underlying
    // chapter/partner: exec/admin OR the signed-in user creating a
    // partner OrgUnit for their own restaurant/church.
    match /org_units/{unit_id} {
      allow read: if true;
      allow create, update: if isExec()
        || (isSignedIn() && request.resource.data.type == 'chapter')
        || (isSignedIn() && request.resource.data.type == 'partner');
      allow delete: if isAdmin();
    }

    // ── memberships (Phase 1 slice 2) ──
    // A row per (user × org_unit). Owner can read + create/update
    // their own row (matches how updateUserChapter dual-writes from
    // the signed-in user's session). Exec can touch any row for
    // admin ops. Nobody deletes — historical record per blueprint §1.
    match /memberships/{id} {
      allow read: if isExec() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isExec()
        || (isSignedIn() && request.resource.data.user_id == request.auth.uid);
      allow update: if isExec()
        || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow delete: if false;
    }

    // ── audit_events (Phase 1 slice 3) ──
    // Blueprint §17 AuditEvent entity. Append-only observability;
    // no updates, no deletes. Any signed-in user can WRITE (client
    // code across the app fires audit rows best-effort from the
    // authenticated context that performed the recorded action).
    // Reads are exec-only — this is the accountability record, not
    // a general activity feed.
    match /audit_events/{id} {
      allow read: if isExec();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── role_assignments (Phase 1 slice 2) ──
    // Shadow of user.role + user.roles[] as first-class rows with
    // scope + start/end. Reads open to the assignee + exec.
    // Creates + updates gated to exec-initiated flows (grantRole,
    // revokeRole in database.js call these under exec context) OR
    // the assignee themselves (bootstrap self-writes during signup).
    // Nobody deletes — ended assignments carry status:ended.
    match /role_assignments/{id} {
      allow read: if isExec() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isExec()
        || (isSignedIn() && request.resource.data.user_id == request.auth.uid);
      allow update: if isExec()
        || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow delete: if false;
    }

    // Deny-by-default for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
