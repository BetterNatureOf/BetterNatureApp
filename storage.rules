rules_version = '2';

// Firebase Storage rules.
//
// A2 lockdown (ID documents): previously `any signed-in user can
// read` because admins viewing the Verify IDs queue needed access.
// That was too broad — any member could enumerate another member's
// government ID through the SDK. We now gate reads on the owner's
// own uid OR an exec/admin role (resolved via Firestore).
//
// IMPORTANT caveat on existing links: Firebase Storage download URLs
// carry a token that stays valid even after stricter rules deploy.
// Tightening the rule does NOT revoke previously-handed-out URLs.
// The migration guidance in COORDINATION.md's A2 deploy plan covers
// re-uploading identity evidence to new paths (which generates fresh
// tokens) and clearing cached `id_front_url` / `id_back_url` fields
// from /users for pending cases.
//
// Deploy with:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    // Firestore sidecar lookup — the Storage auth context carries
    // request.auth.uid but no Firestore reads unless we ask for them.
    function isExecByFirestore() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['executive', 'admin', 'super_admin']
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
             .data.get('roles', []).hasAny(['executive', 'admin', 'super_admin'])
        );
    }

    // H4 — migration write barrier. While a lock doc exists at
    // /migration_locks/id_docs_rotation in Firestore, the revocation
    // script owns the id-docs/ prefix; no new upload can land at a
    // path we're mid-rotating. Owner uploads briefly fail with a
    // clear error during the migration window.
    function idDocsLocked() {
      return firestore.exists(/databases/(default)/documents/migration_locks/id_docs_rotation);
    }

    // ── ID documents ──
    // Path shape (from authFirebase.js → uploadIdImage):
    //   id-docs/{kind}/{uid}-{side}-{timestamp}.jpg
    //
    // Read: owner only (filename prefix is their uid) OR an exec/
    // admin reviewer. Everyone else — including ordinary signed-in
    // members — is denied.
    // Write: owner only, same filename-prefix check, AND the
    // migration lock must NOT be held.
    match /id-docs/{kind}/{filename} {
      allow read: if request.auth != null
        && (filename.matches(request.auth.uid + '-.*') || isExecByFirestore());
      allow write: if request.auth != null
        && filename.matches(request.auth.uid + '-.*')
        && !idDocsLocked()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Profile photos (future) ──
    // Public read is fine: avatars live in /public_profiles as URLs
    // and are intentionally visible to viewers of the leaderboard /
    // chapter roster. Write is still owner-only.
    match /avatars/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Pickup photos ──
    // Restaurants attach a photo of the food when they post a pickup
    // so the volunteer knows what they're grabbing. Path:
    //   pickup-photos/{pickupId}/{uid}-{ts}.jpg
    // Anyone can read (the URLs are capability tokens); signed-in
    // users can upload.
    match /pickup-photos/{pickupId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
