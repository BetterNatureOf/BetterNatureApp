# BetterNature local dev env. Copy to `.env.local` and fill in.
# Only EXPO_PUBLIC_* keys ship to the client bundle.

# OneSignal (push notifications)
# App ID is also embedded in app.json -> expo.extra.onesignalAppId so
# native dev builds can find it without a .env.
EXPO_PUBLIC_ONESIGNAL_APP_ID=f21e4ed4-1498-41ad-b8fb-20962763a6dd
EXPO_PUBLIC_NOTIFY_PROVIDER=onesignal

# Firebase config is in app.json -> expo.extra.firebase; no env needed.

# Native Google sign-in. Use OAuth clients from the same Google project as Firebase.
# Register the reversed iOS client ID in the app target's URL Types (CFBundleURLTypes).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Mapbox map rendering (web GL JS + native @rnmapbox/maps). PUBLIC token
# only (starts with pk.); restrict it to app.betternatureofficial.org and the
# app bundle IDs in the Mapbox account. Without it the web map falls back to
# a labeled simplified OpenStreetMap view and native shows a plain notice.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Server-side routing (Cloud Functions only, never in the app):
#   MAPBOX_SERVER_TOKEN   secret/scoped token for the Matrix + Directions APIs
#   RESCUE_ROUTING_BASE_URL / RESCUE_ROUTING_TOKEN  optional OSRM-compatible fallback
# Set these as Functions secrets/env at deploy time, not here.
